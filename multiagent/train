#!/bin/zsh

for table in $(ls *0.json); do
    ./reset_q_cache $table
done

sed -E "s/PARAM/epochs/g; s/VALUE/1000/g" updateParam.sed | sed -E -i '' -f - multiAgents.py
python pacman.py --pacman QLearningAgent --parallel --quietTextGraphics
sed -E "s/PARAM/epochs/g; s/VALUE/0/g" updateParam.sed | sed -E -i '' -f - multiAgents.py