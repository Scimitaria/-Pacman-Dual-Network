#!/bin/zsh

function median {
    sorted_data=(${(n)$1});
    len=${#sorted_data}

    if (( len % 2 == 1 )); then
        # Odd length: take the exact middle element
        median=$sorted_data\[$((len / 2 + 1))]
    else
        # Even length: average the two middle elements
        mid1=$sorted_data\[$((len / 2))]
        mid2=$sorted_data\[$((len / 2 + 1))]
        median=$(( (mid1 + mid2) / 2.0 ))
    fi

    echo "Median: $median"
}

function toPercent {
    (( num = $1 * 100 ))
    printf "%d%%" $num
}

numIterations=10

function analyze {
    out=$(python pacman.py --numGames $numIterations --quietTextGraphics --multithread --pacman $1)

    if [[ "$out" =~ '\(([0-9]\.[0-9]{2})\)' ]]; then
        extracted=$(toPercent "$match[1]")
        echo "$2 Agent Win Rate: $extracted"
    fi
    if [[ "$out" =~ 'Average Score: ([0-9]{1,5}\.[0-9])' ]]; then
        extracted="$match[1]"
        echo "$2 Agent Average Score: $extracted"
    fi 
}

analyze RandomAgent "Random Action"
analyze AStarAgent "A*"
analyze randStateAgent "Random Policy"
analyze QLearningAgent "Q-Learning"
